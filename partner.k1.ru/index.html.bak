on:absolute;top:0;right:0;bottom:0;left:0;background:#080a109e;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);animation:fade .25s ease both}@keyframes fade{0%{opacity:0}}.modal-sheet{position:relative;z-index:2;width:100%;max-width:520px;max-height:92vh;overflow-y:auto;background:var(--card);color:var(--fg);border-radius:24px 24px 0 0;padding:clamp(1.4rem,5vw,2.2rem);animation:sheetUp .32s var(--e-out) both;box-shadow:0 -20px 60px -20px #00000080}@keyframes sheetUp{0%{transform:translateY(28px);opacity:0}}.modal-close{position:absolute;top:.8rem;right:.8rem;width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--border);border-radius:50%;background:var(--bg);cursor:pointer}.modal-close svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}.modal-sheet h2{font-size:clamp(1.6rem,5vw,2.1rem);margin-bottom:.6rem;padding-right:2.5rem}.modal-lead{color:var(--fg-muted);font-size:.96rem;margin-bottom:1.4rem}.lead-form{display:grid;gap:.9rem}.field{display:grid;gap:.32rem}.field>span{font-size:.82rem;font-weight:700;color:var(--fg-muted)}.field input,.field select{min-height:48px;padding:.6rem .85rem;border:1.5px solid var(--border);border-radius:12px;background:var(--bg);transition:border-color .2s}.field input:focus,.field select:focus{border-color:var(--accent)}.field.has-error input,.field.has-error select{border-color:#c62a52}.err{font-style:normal;font-size:.78rem;color:#c62a52;min-height:0}.form-note{font-size:.8rem;color:var(--fg-muted);text-align:center}.modal-success{display:grid;gap:.9rem;padding:.6rem 0 .4rem}.success-badge{display:inline-grid;place-items:center;width:56px;height:56px;border-radius:50%;background:var(--lime);color:var(--lime-ink)}.success-badge svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round}.modal-success p{color:var(--fg-muted)}.modal-success ul{display:grid;gap:.4rem;font-size:.92rem;color:var(--fg-muted)}.modal-success li{padding-left:1.1rem;position:relative}.modal-success li:before{content:"";position:absolute;left:0;top:.55rem;width:7px;height:7px;border-radius:50%;background:var(--accent)}.reveal{opacity:0;transition:opacity .55s var(--e-out)}.reveal.is-in{opacity:1}@media (max-width: 639px){.formats{padding-block:3rem}.formats .sec-head{margin-bottom:1.5rem}.tabs{margin-bottom:1rem}}@media (min-width: 640px){.panel-cols{grid-template-columns:repeat(2,1fr)}.panel-col+.panel-col{border-left:1px solid var(--border)}.footer-grid{grid-template-columns:1fr 1fr}.foot-nav{grid-template-columns:repeat(2,1fr)}}@media (min-width: 900px){html{scroll-padding-top:104px}.nav-desktop{display:flex}.btn-header{display:inline-flex}.burger{display:none}.mobile-menu{display:none!important}.sec-head--split{grid-template-columns:1.05fr .95fr;align-items:end;gap:2.5rem}.process-gallery{grid-template-columns:repeat(12,1fr)}.process-shot--receive{grid-column:span 7;min-height:590px}.process-shot--service{grid-column:span 5;min-height:590px}.process-shot--handover{grid-column:2 / span 10;min-height:660px}.num-row{grid-template-columns:80px minmax(0,1fr) minmax(0,22ch);align-items:end;gap:1.5rem}.num-label{grid-column:3;padding-bottom:.5rem}.route:before{left:50%}.route-step{grid-template-columns:1fr 56px 1fr;align-items:center;gap:2.5rem}.route-marker{grid-column:2;grid-row:1;width:56px;height:56px;font-size:1.3rem}.route-body{grid-column:1;grid-row:1;text-align:right}.route-body p,.route-body .chips{margin-left:auto}.route-body .chips{justify-content:flex-end}.route-visual{grid-column:3;grid-row:1;margin-top:0}.route-step:nth-child(2n) .route-body{grid-column:3;text-align:left}.route-step:nth-child(2n) .route-body p,.route-step:nth-child(2n) .route-body .chips{margin-left:0;margin-right:auto}.route-step:nth-child(2n) .route-body .chips{justify-content:flex-start}.route-step:nth-child(2n) .route-visual{grid-column:1;grid-row:1}.app-wrap{grid-template-columns:1.05fr .95fr}.panel-hero{grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr)}.panel-photo,.panel-photo img,.panel-motion video{min-height:390px}.panel-motion{aspect-ratio:auto}.panel-top{align-content:center}.step-line{grid-template-columns:repeat(4,1fr);gap:1px}.step-line li{padding:1.6rem 1.2rem}@media (hover: hover){.step-line li:hover{padding-left:1.2rem;transform:translateY(-4px)}}.faq-wrap .sec-head{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:2rem}.footer-grid{grid-template-columns:1.1fr .7fr 1.2fr}.final-wrap{display:grid;grid-template-columns:1.2fr .8fr;align-items:center}.modal-root{align-items:center}.modal-sheet{border-radius:26px}.foot-nav{grid-template-columns:1fr}.panel-cols{grid-template-columns:repeat(3,1fr)}}@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}.reveal{opacity:1}.hero-media video{display:none}.hero-media{background:url(.data:image/webp;base64,) center / cover no-repeat}.video-toggle{display:none}}@media (max-width: 767px){.video-toggle{top:1rem;right:1rem}.network-frame{aspect-ratio:3 / 4}.network-frame video{width:100%;height:100%;object-fit:cover;object-position:center}.network-shade{background:linear-gradient(180deg,#050911cc,#05091129 48%,#050911f0),linear-gradient(90deg,rgba(5,9,17,.45),transparent 82%)}.network-copy{top:1.35rem;left:1rem;right:4.6rem;width:auto;gap:.55rem}.network-copy .eyebrow{font-size:.68rem}.network-copy h2{max-width:14ch;font-size:clamp(2rem,10.4vw,3.1rem);line-height:.9}.network-copy>p:last-child{display:none}.network-stages{grid-template-columns:1fr;gap:.2rem}.network-stages span{min-height:34px;padding:.35rem .55rem;font-size:.72rem}.network-stats{grid-template-columns:1fr}.network-stats article{grid-template-columns:minmax(110px,auto) 1fr;align-items:baseline;border-left:0;border-top:1px solid rgba(255,255,255,.16)}.network-stats b{font-size:1.8rem}.pay-brief{padding:1rem}.pay-brief-head{align-items:flex-start;flex-direction:column;gap:.25rem}.pay-benefits{grid-template-columns:1fr}.pay-benefits article{min-height:0}.hero{min-height:820px}.hero-media video{object-position:68% center}.hero-shade{background:linear-gradient(90deg,#060810eb,#06081094),linear-gradient(0deg,#060810f5,#0608102e 74%)}.video-toggle{right:1rem;top:1rem}.process-gallery{width:100%;gap:2px}.process-shot{min-height:520px}.process-shot--receive img{object-position:60% center}.process-shot--service img{object-position:58% center}.hero-grid{background-size:48px 48px}.num-val{letter-spacing:-.055em}}
</style>
</head>
  <body>
    <a class="skip-link" href="#hero">Перейти к содержимому</a>

    <!-- ============ HEADER ============ -->
    <header class="site-header" id="site-header" data-testid="header-main">
      <div class="header-inner">
        <a class="brand" href="#hero" data-testid="link-brand" aria-label="К1 Про — на главную">
          <img class="brand-logo" src="data:image/png;base64," width="399" height="133" alt="К1 Шинный СПА" />
        </a>

        <nav class="nav-desktop" aria-label="Основная навигация">
          <a href="#numbers" data-testid="link-nav-numbers">Сеть</a>
          <a href="#process" data-testid="link-nav-process">Как это работает</a>
          <a href="#formats" data-testid="link-nav-formats">Форматы ПУШ</a>
          <a href="#change" data-testid="link-nav-change">Маршрут</a>
          <a href="#app" data-testid="link-nav-app">Приложение</a>
          <a href="#steps" data-testid="link-nav-steps">Подключение</a>
        </nav>

        <div class="header-actions">
          <button
            class="icon-btn"
            type="button"
            id="theme-toggle"
            data-testid="button-theme-toggle"
            aria-label="Переключить тёмную тему"
            aria-pressed="false"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="ic-sun">
              <circle cx="12" cy="12" r="4.4" />
              <path d="M12 1.8v2.6M12 19.6v2.6M1.8 12h2.6M19.6 12h2.6M4.8 4.8l1.9 1.9M17.3 17.3l1.9 1.9M19.2 4.8l-1.9 1.9M6.7 17.3l-1.9 1.9" />
            </svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="ic-moon">
              <path d="M20 14.6A8.6 8.6 0 1 1 9.4 4a7.3 7.3 0 0 0 10.6 10.6Z" />
            </svg>
          </button>
          <button class="btn btn-primary btn-header" type="button" data-open-modal data-testid="button-header-cta">
            Стать партнёром
          </button>
          <button
            class="icon-btn burger"
            type="button"
            id="burger"
            data-testid="button-mobile-menu"
            aria-label="Открыть меню"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- ============ MOBILE MENU ============ -->
    <div class="mobile-menu" id="mobile-menu" data-testid="menu-mobile" hidden>
      <nav aria-label="Мобильная навигация">
        <a href="#numbers" data-testid="link-mnav-numbers"><span>01</span>Федеральная сеть</a>
        <a href="#process" data-testid="link-mnav-process"><span>02</span>Как это работает</a>
        <a href="#formats" data-testid="link-mnav-formats"><span>03</span>Форматы ПУШ</a>
        <a href="#change" data-testid="link-mnav-change"><span>04</span>Маршрут заказа</a>
        <a href="#app" data-testid="link-mnav-app"><span>05</span>Приложение</a>
        <a href="#steps" data-testid="link-mnav-steps"><span>06</span>Подключение</a>
        <a href="#faq" data-testid="link-mnav-faq"><span>07</span>Вопросы</a>
      </nav>
      <button class="btn btn-primary btn-block" type="button" data-open-modal data-testid="button-mobile-cta">
        Стать партнёром
      </button>
    </div>

    <main>
      <!-- ============ HERO ============ -->
      <section class="hero" id="hero" data-testid="section-hero">
        <div class="hero-media" aria-hidden="true">
          <video
            id="hero-video"
            autoplay
            muted
            loop
            playsinline
            data-testid="video-hero"
          >
            <source src="./video/main.webm" type="video/mp4" />
          </video>
          <div class="hero-shade"></div>
        </div>

        <button
          class="video-toggle media-toggle"
          type="button"
          id="video-toggle"
          aria-label="Поставить видео на паузу"
          aria-pressed="false"
          data-testid="button-video-toggle"
        >
          <span class="media-toggle-icon" aria-hidden="true"></span>
        </button>

        <div class="hero-inner">
          <p class="eyebrow" data-testid="text-hero-eyebrow">
            <span class="dot"></span> Партнёрская программа для шинных центров и шиномонтажей
          </p>
          <h1 data-testid="text-hero-title">
            Больше заказов<br />
            и услуг.<br />
            <em>Доход с каждой</em><br />
            выданной шины.<br />
            Поставьте свой центр<br />
            на маршрут заказов
          </h1>
          <div class="hero-cta">
            <button class="btn btn-lime btn-lg" type="button" data-open-modal data-testid="button-hero-cta">
              Стать партнёром
              <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </button>
            <a class="btn btn-ghost btn-lg" href="#formats" data-testid="link-hero-formats">Выбрать формат ПУШ</a>
          </div>
        </div>

      </section>

      <!-- ============ NUMBERS ============ -->
      <section class="numbers network" id="numbers" data-testid="section-numbers">
        <div class="network-frame" data-testid="video-federal-network">
          <video
            id="network-video"
            muted
            loop
            autoplay
            playsinline
            preload="metadata"
            aria-label="Федеральная сеть К1 Про: партнёры на карте России, логистический центр в Давыдово и доставка шин"
          >
            <source src="./video/logist.webm" type="video/mp4" />
          </video>
          <div class="network-shade"></div>
          <div class="network-copy">
            <p class="eyebrow"><span class="dot"></span> Федеральная сеть К1 Про</p>
            <h2>
              <em data-count="1000" data-suffix="+">1 000+</em> шинных центров<br />
              уже в программе <span>К1 Про</span>
            </h2>
            <p>От завода и федеральных логистических центров — к партнёрам по всей стране.</p>
          </div>
          <div class="network-stages" aria-label="Сцены федеральной сети">
            <span class="is-active" data-network-stage="0"><b>01</b> 1 000+ шинных центров</span>
            <span data-network-stage="1"><b>02</b> Давыдово и логистические центры</span>
            <span data-network-stage="2"><b>03</b> Доставка по всей России</span>
          </div>
          <button
            class="network-toggle media-toggle"
            id="network-video-toggle"
            type="button"
            aria-label="Приостановить федеральное видео"
            aria-pressed="false"
            data-testid="button-network-video"
          >
            <span class="media-toggle-icon" aria-hidden="true"></span>
          </button>
        </div>

        <div class="wrap network-stats" data-testid="list-numbers">
          <article data-testid="stat-payouts">
            <b data-count="145" data-suffix=" млн ₽">145 млн ₽</b>
            <span>вознаграждений выплачено партнёрам</span>
          </article>
          <article data-testid="stat-visitors">
            <b data-count="14" data-suffix=" млн+">14 млн+</b>
            <span>посетителей интернет-площадок в год</span>
          </article>
          <article data-testid="stat-skus">
            <b data-count="40000" data-suffix="+">40 000+</b>
            <span>позиций шин и дисков</span>
          </article>
        </div>
      </section>

      <!-- ============ PROCESS MEDIA ============ -->
      <section class="process-media" id="process" aria-labelledby="process-media-title" data-testid="section-process-media">
        <div class="wrap process-media-head">
          <p class="eyebrow"><span class="dot"></span> ПУШ в работе</p>
          <h2 id="process-media-title">От поставки до выдачи.<br /><em>Всё проходит через ваш центр.</em></h2>
        </div>
        <div class="process-gallery">
          <figure class="process-shot process-shot--receive">
            <img
              src="data:image/webp;base64,"
              width="1600"
              height="856"
              loading="lazy"
              decoding="async"
              alt="Сотрудник шинного центра принимает и сканирует комплект шин"
            />
            <figcaption>
              <span>01 · Приёмка</span>
              <strong>Заказ приезжает в ПУШ</strong>
              <p>Принимаете отправление, сканируете комплект и видите статус в К1 Про.</p>
            </figcaption>
          </figure>
          <figure class="process-shot process-shot--service">
            <img
              src="data:image/webp;base64,"
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
              alt="Мастер выполняет шиномонтаж автомобиля на современном сервисном посту"
            />
            <figcaption>
              <span>02 · Услуга</span>
              <strong>Клиент записан, пост загружен</strong>
              <p>Онлайн-запись с предоплатой попадает в единый календарь центра.</p>
            </figcaption>
          </figure>
          <figure class="process-shot process-shot--handover">
            <img
              src="data:image/webp;base64,"
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
              alt="Сотрудник шинного центра выдаёт подготовленный заказ клиенту"
            />
            <figcaption>
              <span>03 · Выдача</span>
              <strong>Клиент получает заказ, вы — вознаграждение</strong>
              <p>Выдаёте шины и диски, получаете до 10% и превращаете визит в новые услуги.</p>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ FORMATS ============ -->
      <section class="formats" id="formats" data-testid="section-formats">
        <div class="wrap">
          <header class="sec-head sec-head--split">
            <h2>Три формата <em>ПУШ</em></h2>
            <p>
              ПУШ — пункт удобного шиномонтажа. Формат подбирается под вашу площадь и услуги: можно
              начать с записи без склада, а товарную программу подключить позже.
            </p>
          </header>

          <div class="tabs" role="tablist" aria-label="Форматы ПУШ" data-testid="tabs-formats">
            <button
              class="tab is-active"
              role="tab"
              id="tab-express"
              aria-controls="panel-express"
              aria-selected="true"
              data-testid="tab-express"
            >
              <span class="tab-name">Экспресс</span>
              <span class="tab-meta">без склада</span>
            </button>
            <button
              class="tab"
              role="tab"
              id="tab-profi"
              aria-controls="panel-profi"
              aria-selected="false"
              tabindex="-1"
              data-testid="tab-profi"
            >
              <span class="tab-name">Профи</span>
              <span class="tab-meta">от 15 м²</span>
            </button>
            <button
              class="tab"
              role="tab"
              id="tab-business"
              aria-controls="panel-business"
              aria-selected="false"
              tabindex="-1"
              data-testid="tab-business"
            >
              <span class="tab-name">Бизнес</span>
              <span class="tab-meta">от 100 м²</span>
            </button>
          </div>

          <div class="panels" id="format-panels">
            <!-- panels rendered by JS -->
          </div>
        </div>
      </section>

      <!-- ============ NARRATIVE ============ -->
      <section class="change" id="change" data-testid="section-change">
        <div class="wrap">
          <header class="sec-head">
            <p class="eyebrow eyebrow--dark"><span class="dot"></span> Что изменится в вашем центре</p>
            <h2>Маршрут заказа<br />проходит <em>через вас</em></h2>
          </header>

          <ol class="route" data-testid="list-route">
            <li class="route-step" data-testid="route-step-1">
              <div class="route-marker"><span>1</span></div>
              <div class="route-body">
                <h3>Поток заказов</h3>
                <p>
                  Клиенты находят ваш центр на площадках К1 и бронируют время онлайн — со 100%
                  предоплатой. Приходят и те, кто узнал о вас впервые, и те, кто отметил вас
                  «любимым» в приложении К1.
                </p>
                <ul class="chips">
                  <li>+25% клиентов</li>
                  <li>онлайн-запись</li>
                  <li>смарт-рассылки</li>
                </ul>
              </div>
              <div class="route-visual route-visual--orders" aria-hidden="true">
                <div class="mini-order"><span class="mo-dot"></span>Шиномонтаж R17 · 14:30</div>
                <div class="mini-order"><span class="mo-dot"></span>Сезонная замена · 16:00</div>
                <div class="mini-order is-new"><span class="mo-dot"></span>Новая запись · 17:15</div>
              </div>
            </li>

            <li class="route-step" data-testid="route-step-2">
              <div class="route-marker"><span>2</span></div>
              <div class="route-body">
                <h3>Единое расписание</h3>
                <p>
                  Ваши клиенты и заказы с платформы — в одном календаре. Вы сами распределяете
                  записи между постами и сменами, видите загрузку и не держите двойной учёт.
                </p>
                <ul class="chips">
                  <li>управление постами</li>
                  <li>персонал и смены</li>
                  <li>без двойного учёта</li>
                </ul>
              </div>
              <div class="route-visual route-visual--sched" aria-hidden="true">
                <div class="sched-bar"><i style="--w: 72%"></i><span>Пост 1</span></div>
                <div class="sched-bar"><i style="--w: 46%"></i><span>Пост 2</span></div>
                <div class="sched-bar"><i style="--w: 88%"></i><span>Пост 3</span></div>
              </div>
            </li>

            <li class="route-step" data-testid="route-step-3">
              <div class="route-marker"><span>3</span></div>
              <div class="route-body">
                <h3>Выдача шин и дисков</h3>
                <p>
                  Вы становитесь точкой выдачи заказов с площадок К1: принимаете отправления,
                  выдаёте товар, оформляете возвраты — и получаете вознаграждение до 10% от
                  стоимости товаров в заказе.
                </p>
                <ul class="chips">
                  <li>40 000+ позиций</li>
                  <li>до 10% за выдачу</li>
                  <li>сезонное хранение</li>
                </ul>
              </div>
              <div class="route-visual route-visual--pickup" aria-hidden="true">
                <div class="stack-tire"></div>
                <div class="stack-tire"></div>
                <div class="stack-tire"></div>
                <div class="pickup-tag">Выдано · +7,5%</div>
              </div>
            </li>

            <li class="route-step" data-testid="route-step-4">
              <div class="route-marker"><span>4</span></div>
              <div class="route-body">
                <h3>K1 Пэй: оплата и контроль</h3>
                <p>
                  Клиент оплачивает шиномонтаж по QR, сотрудник сразу видит подтверждение, а
                  электронный чек, платежи и отчёты остаются в приложении К1 Про.
                </p>
                <ul class="chips">
                  <li>без POS-терминала</li>
                  <li>автоматический чек</li>
                  <li>реестр и отчёты</li>
                  <li>отзывы и рейтинг</li>
                </ul>
              </div>
              <div class="route-visual route-visual--pay" data-testid="card-k1-pay">
                <div class="pay-video">
                  <video
                    id="k1-pay-video"
                    muted
                    loop
                    autoplay
                    playsinline
                    preload="metadata"
                    aria-label="Клиент оплачивает шиномонтаж по QR-коду K1 Пэй и уезжает"
                    data-testid="video-k1-pay"
                  >
                    <source src="./video/pay-qr.webm" type="video/mp4" />
                  </video>
                  <div class="pay-video-caption">
                    <span>Оплата на месте</span>
                    <b>QR → оплачено → можно ехать</b>
                  </div>
                  <button
                    class="pay-video-toggle media-toggle"
                    id="k1-pay-video-toggle"
                    type="button"
                    aria-label="Приостановить видео K1 Пэй"
                    aria-pressed="false"
                    data-testid="button-k1-pay-video"
                  >
                    <span class="media-toggle-icon" aria-hidden="true"></span>
                  </button>
                </div>
                <div class="pay-brief">
                  <div class="pay-brief-head">
                    <span>K1 Пэй</span>
                    <h4>Почему это выгодно?</h4>
                  </div>
                  <div class="pay-benefits">
                    <article>
                      <strong>до 50 000 ₽</strong>
                      <p>QR-платежи по СБП снижают затраты на эквайринг и расходники; экономия зависит от оборота.</p>
                    </article>
                    <article>
                      <strong>2% за результат</strong>
                      <p>Комиссия только с фактически оказанных услуг. K1 Пэй уже включён.</p>
                    </article>
                    <article>
                      <strong>На следующий день</strong>
                      <p>Платежи за смену поступают одной суммой на следующий рабочий день.</p>
                    </article>
                    <article>
                      <strong>Без отдельного счёта</strong>
                      <p>Переводим деньги на расчётный счёт вашего бизнеса в любом банке.</p>
                    </article>
                  </div>
                  <p class="pay-legal">
                    Отдельной платы за K1 Пэй нет: электронный чек формируется автоматически.
                    Собственная ККМ остаётся у предпринимателя и используется по требованиям 54-ФЗ.
                  </p>
                </div>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <!-- ============ APP MOCKUP ============ -->
      <section class="app" id="app" data-testid="section-app">
        <div class="wrap app-wrap">
          <div class="app-copy">
            <p class="eyebrow"><span class="dot"></span> К1 Про в работе</p>
            <h2>Один экран<br />на весь <em>день</em></h2>
            <p class="app-lead">
              Приложение К1 Про заменяет журнал записей, таблицы по выдаче и переписки по сменам.
              Всё, что нужно приёмщику и управляющему — в одном списке дел.
            </p>
            <ul class="app-list" data-testid="list-app-features">
              <li><b>Расписание.</b> Записи с площадок и ваши собственные — в одном календаре.</li>
              <li><b>Выдача.</b> Приёмка отправлений, выдача заказов, возвраты по шагам.</li>
              <li><b>Загрузка.</b> Посты, персонал и слоты — с прогнозом на день и неделю.</li>
              <li><b>Отчёты и отзывы.</b> Итоги смены, вознаграждение, обратная связь клиентов.</li>
            </ul>
          </div>

          <figure class="app-mock" data-testid="mock-app">
            <div class="phone phone--live">
              <div class="phone-top"><span class="ph-pill"></span></div>
              <div class="phone-screen phone-screen--live">
                <video
                  id="app-recording"
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster="data:image/webp;base64,"
                  aria-label="Оригинальная запись работы приложения К1 Про"
                  data-testid="video-app-recording"
                >
                  <source src="data:video/mp4;base64," type="video/mp4" />
                </video>
                <div class="phone-video-controls">
                  <button
                    class="phone-video-btn media-toggle"
                    id="app-recording-toggle"
                    type="button"
                    aria-label="Воспроизвести запись экрана"
                    aria-pressed="true"
                    data-testid="button-app-video-toggle"
                  >
                    <span class="media-toggle-icon" aria-hidden="true"></span>
                  </button>
                </div>
              </div>
            </div>
            <figcaption>Оригинальная запись экрана приложения К1 Про · 1:21</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ STEPS ============ -->
      <section class="steps" id="steps" data-testid="section-steps">
        <div class="wrap">
          <header class="sec-head">
            <h2>Подключение <em>за 4 шага</em></h2>
          </header>
          <ol class="step-line" data-testid="list-steps">
            <li data-testid="step-1"><b>01</b><h3>Регистрация</h3><p>Заводите учётную запись на b2b.4tochki.ru — она же вход в приложение К1 Про.</p></li>
            <li data-testid="step-2"><b>02</b><h3>Параметры центра</h3><p>Заполняете форму по шинному центру: площадь, посты, услуги — и выбираете формат ПУШ.</p></li>
            <li data-testid="step-3"><b>03</b><h3>Условия</h3><p>Подписываете условия К1 Про: агентский и лицензионный договоры, без франшизных платежей.</p></li>
            <li data-testid="step-4"><b>04</b><h3>Запуск</h3><p>Проходите бесплатное дистанционное обучение, получаете оформление точки и первые заказы.</p></li>
          </ol>
          <p class="steps-note" data-testid="text-steps-note">
            Старт не требует сложных вложений: приложение бесплатно, а объём заказов зависит от
            локации, сезона и рейтинга — гарантированный доход программа не обещает.
          </p>
        </div>
      </section>

      <!-- ============ FAQ ============ -->
      <section class="faq" id="faq" data-testid="section-faq">
        <div class="wrap faq-wrap">
          <header class="sec-head">
            <h2>Коротко<br />о <em>главном</em></h2>
            <p class="faq-side">
              Подробные ответы и полный список вопросов — на
              <a href="https://pro.k1.ru/" target="_blank" rel="noopener noreferrer">pro.k1.ru</a>.
            </p>
          </header>
          <div class="acc" id="faq-acc" data-testid="accordion-faq">
            <!-- items rendered by JS -->
          </div>
        </div>
      </section>

      <!-- ============ FINAL CTA ============ -->
      <section class="final" data-testid="section-final-cta">
        <div class="wrap final-wrap">
          <div class="final-copy">
            <h2>Поставьте свой центр<br />на <em>маршрут заказов</em></h2>
            <button class="btn btn-lime btn-lg" type="button" data-open-modal data-testid="button-final-cta">
              Стать партнёром
              <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </button>
          </div>
          <svg class="final-wheel" viewBox="0 0 200 200" aria-hidden="true">
            <g class="fw-spin">
              <circle cx="100" cy="100" r="94" />
              <circle cx="100" cy="100" r="62" />
              <circle cx="100" cy="100" r="30" />
              <path d="M100 6v188M6 100h188M34 34l132 132M166 34L34 166" />
            </g>
          </svg>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="site-footer" data-testid="footer-main">
      <div class="wrap footer-grid">
        <div class="foot-brand">
          <a class="brand brand--foot" href="#hero" aria-label="К1 Про — на главную">
            <img class="brand-logo" src="data:image/png;base64," width="399" height="133" alt="К1 Шинный СПА" />
          </a>
          <p>Партнёрская программа для шинных центров и шиномонтажей.</p>
        </div>
        <nav class="foot-nav" aria-label="Навигация в подвале">
          <a href="#numbers">Федеральная сеть</a>
          <a href="#process">Как это работает</a>
          <a href="#formats">Форматы ПУШ</a>
          <a href="#change">Маршрут заказа</a>
          <a href="#app">Приложение</a>
          <a href="#steps">Подключение</a>
        </nav>
        <div class="foot-legal">
          <p class="foot-fine">
            Программа партнёрства К1 Про — модель сотрудничества с ООО «Пауэр Интернэшнл-шины».
            Условия сотрудничества, вознаграждение и требования к площади определяются договором.
            Цифры приведены по данным pro.k1.ru.
          </p>
        </div>
      </div>
    </footer>

    <!-- ============ MODAL ============ -->
    <div class="modal-root" id="modal-root" data-testid="modal-lead" hidden>
      <div class="modal-backdrop" data-close-modal></div>
      <div class="modal-sheet" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button class="modal-close" type="button" data-close-modal aria-label="Закрыть форму" data-testid="button-modal-close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <div class="modal-body" id="modal-body">
          <p class="eyebrow eyebrow--dark"><span class="dot"></span> Заявка на подключение</p>
          <h2 id="modal-title">Стать партнёром К1 Про</h2>
          <form class="lead-form" id="lead-form" novalidate>
            <label class="field">
              <span>Имя и фамилия</span>
              <input type="text" name="name" required autocomplete="name" placeholder="Алексей Смирнов" data-testid="input-name" />
              <em class="err" data-err></em>
            </label>
            <label class="field">
              <span>Телефон</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+7 900 000-00-00" data-testid="input-phone" />
              <em class="err" data-err></em>
            </label>
            <label class="field">
              <span>Город</span>
              <input type="text" name="city" required autocomplete="address-level2" placeholder="Казань" data-testid="input-city" />
              <em class="err" data-err></em>
            </label>
            <label class="field">
              <span>Тип центра</span>
              <select name="type" required data-testid="select-type">
                <option value="">Выберите вариант</option>
                <option>Шиномонтаж без склада</option>
                <option>Шинный центр с площадью от 15 м²</option>
                <option>Шинный центр с площадью от 100 м²</option>
                <option>Сеть шинных центров</option>
              </select>
              <em class="err" data-err></em>
            </label>
            <button class="btn btn-primary btn-block btn-lg" type="submit" data-testid="button-submit-lead">
              Отправить заявку
            </button>
            <p class="form-note">Нажимая кнопку, вы ничего не отправляете: это демонстрация интерфейса.</p>
          </form>
        </div>
      </div>
    </div>
  </body>
</html>
