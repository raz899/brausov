    <style>:root{--paper: #f5f6f8;--paper-2: #eef0f3;--surface: #ffffff;--ink: #1f2430;--ink-soft: #3d4d55;--muted: #6b7280;--line: #e3e6ea;--blue: #ff7a1a;--blue-deep: #d95d00;--blue-soft: #fff1e6;--lime: #ff8300;--lime-ink: #ffffff;--on-dark: #f4f3ef;--on-dark-muted: #c7cbd1;--dark-bg: #171a1f;--dark-surface: #20242b;--shell: 1240px;--pad: clamp(1.1rem, 4vw, 3.5rem);--r-s: 10px;--r-m: 18px;--r-l: 28px;--e-out: cubic-bezier(.22, 1, .36, 1);--e-io: cubic-bezier(.65, 0, .35, 1);--font-d: "Onest", "Segoe UI", system-ui, sans-serif;--font-b: "Manrope", "Segoe UI", system-ui, sans-serif;--bg: var(--paper);--fg: var(--ink);--card: var(--surface);--accent: var(--blue);--accent-fg: #fff;--accent-tint: var(--blue-soft);--border: var(--line);--fg-muted: var(--muted);--dark-section: #1f2430}[data-theme=dark]{--bg: var(--dark-bg);--fg: #eceae5;--card: var(--dark-surface);--accent: #ff963f;--accent-fg: #171a1f;--accent-tint: #3a2a20;--border: #353a43;--fg-muted: #aab0ba;--paper-2: #1d2127;--dark-section: #20242b;--lime: #ff963f}*,*:before,*:after{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:92px;-webkit-text-size-adjust:100%}body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font-b);font-size:17px;line-height:1.6;font-weight:450;overflow-x:hidden;-webkit-font-smoothing:antialiased;transition:background-color .35s var(--e-io),color .35s var(--e-io)}body.is-locked{overflow:hidden}h1,h2,h3{font-family:var(--font-d);font-weight:800;letter-spacing:-.03em;line-height:.98;margin:0;text-wrap:balance}h1{font-size:clamp(2.45rem,7.6vw,6rem)}h2{font-size:clamp(2rem,5.2vw,4.1rem)}h3{font-size:clamp(1.22rem,2.2vw,1.7rem);line-height:1.1}p{margin:0}em{font-style:normal;color:var(--accent)}a{color:inherit;text-decoration:none}ul,ol{margin:0;padding:0;list-style:none}img,svg{max-width:100%}button,input,select{font:inherit;color:inherit}:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}.wrap{width:100%;max-width:var(--sh